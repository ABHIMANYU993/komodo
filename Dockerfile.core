# ============================================================
# Komodo Core — Custom Image (v2.4.0)
# Bases on the official upstream image, then:
#   1. Patches PROCESSES_EXPIRY: 15000ms → 500ms (real-time process refresh)
#      Patch location: offset 0x4045c7e in /usr/local/bin/core
#      Original bytes: 98 3a 00 00  (0x3A98 = 15000)
#      Patched  bytes: f4 01 00 00  (0x01F4 = 500)
#   2. Overlays 1-second UI assets (historical graph + process table polling)
# ============================================================

FROM ghcr.io/moghtech/komodo-core:2 AS base

# Patch PROCESSES_EXPIRY in the core binary (15000ms → 500ms for real-time process polling)
# Offset 0x4045c7c: MOV RAX, <imm64> instruction where imm starts at byte +2
# We overwrite only the 4 lower bytes of the 64-bit immediate: f4 01 00 00 = 500ms
RUN python3 -c "
import struct, os, sys

BINARY = '/usr/local/bin/core'
OFFSET = 0x4045c7e          # start of the 32-bit immediate inside the MOV imm64
ORIGINAL = b'\x98\x3a\x00\x00'  # 15000 ms in little-endian
PATCHED  = b'\xf4\x01\x00\x00'  # 500 ms  in little-endian

with open(BINARY, 'r+b') as f:
    f.seek(OFFSET)
    current = f.read(4)
    if current == PATCHED:
        print('Binary already patched (idempotent). OK.')
        sys.exit(0)
    if current != ORIGINAL:
        print(f'Unexpected bytes at offset 0x{OFFSET:x}: {current.hex()} — aborting patch', file=sys.stderr)
        sys.exit(1)
    f.seek(OFFSET)
    f.write(PATCHED)
    print(f'Patched core binary: offset=0x{OFFSET:x}  {ORIGINAL.hex()} -> {PATCHED.hex()}  (15000ms -> 500ms)')
"

# Copy patched UI JS assets (1-second historical granularity + process refresh dropdown)
COPY ui-patched-assets/ /app/ui/assets/

LABEL org.opencontainers.image.title="Komodo Core (ABHIMANYU993 fork)" \
      org.opencontainers.image.description="Komodo Core with real-time process polling (500ms), 1-second UI updates, and Android periphery support." \
      org.opencontainers.image.source="https://github.com/ABHIMANYU993/komodo" \
      org.opencontainers.image.version="2.4.0"
